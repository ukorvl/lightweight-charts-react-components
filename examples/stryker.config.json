{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "thresholds": {
    "break": 90
  },
  "ignorePatterns": ["/coverage", "/dist"],
  "ignoreStatic": true,
  "mutate": [
    "src/common/tooltips.ts",
    "src/common/utils.ts",
    "src/samples/PriceLines/priceLinesStore.ts",
    "src/samples/RangeSwitcher/rangeSwitcherStore.tsx",
    "src/samples/RealTime/realTimeDataStore.ts"
  ],
  "vitest": {
    "configFile": "vitest.config.ts",
    "dir": ".",
    "related": false
  },
  "htmlReporter": {
    "fileName": "reports/mutation/examples.html"
  }
}
